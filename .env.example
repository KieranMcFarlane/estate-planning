# Dedicated estate chat persistence. Do not fall back to the generic DATABASE_URL.
ESTATE_DATABASE_URL=postgres://user:password@localhost:5432/pathway_estate_chat
ESTATE_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
ESTATE_CHAT_HOURLY_LIMIT=60

# Private local Parlant backend used by the Next.js AI SDK route.
PARLANT_BASE_URL=http://127.0.0.1:8800

# Twenty CRM lead capture.
TWENTY_BASE_URL=http://127.0.0.1:3010
TWENTY_API_TOKEN=

# Twenty outbound webhook receiver.
# Leave TWENTY_WEBHOOK_SECRET blank until the matching Twenty signature header is confirmed.
TWENTY_WEBHOOK_SECRET=
TWENTY_WEBHOOK_EVENTS_PATH=/home/ubuntu/repos/estate-planning/data/leads/twenty-webhook-events.jsonl
TWENTY_LEAD_SUMMARY_STATE_PATH=/home/ubuntu/repos/estate-planning/data/leads/twenty-lead-summary-state.json
TWENTY_LEAD_SUMMARIES_PATH=/home/ubuntu/repos/estate-planning/data/leads/twenty-lead-summaries.jsonl

# Optional: dispatch completed Twenty lead summaries to the local Hermes API server.
HERMES_LEAD_AUTOMATION_ENABLED=false
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_SESSION_KEY=pathway-estate-leads
HERMES_LEAD_TIMEOUT_MS=8000
HERMES_LEAD_STRATEGY_WAIT_MS=12000
HERMES_LEAD_DISPATCHES_PATH=/home/ubuntu/repos/estate-planning/data/leads/hermes-lead-dispatches.jsonl
HERMES_LEAD_DISPATCH_FAILURES_PATH=/home/ubuntu/repos/estate-planning/data/leads/hermes-lead-dispatch-failures.jsonl

# Optional: send completed lead summaries to a WhatsApp DM via Hermes' local WhatsApp bridge.
HERMES_WHATSAPP_NOTIFY_ENABLED=false
HERMES_WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
HERMES_WHATSAPP_CHAT_ID=
HERMES_WHATSAPP_TIMEOUT_MS=8000
HERMES_WHATSAPP_LEAD_DISPATCHES_PATH=/home/ubuntu/repos/estate-planning/data/leads/whatsapp-lead-dispatches.jsonl
HERMES_WHATSAPP_LEAD_DISPATCH_FAILURES_PATH=/home/ubuntu/repos/estate-planning/data/leads/whatsapp-lead-dispatch-failures.jsonl

# Local fallback lead file.
ESTATE_LEADS_PATH=/home/ubuntu/repos/estate-planning/data/leads/estate-handoffs.jsonl
