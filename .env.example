# Dedicated estate chat persistence. Do not fall back to the generic DATABASE_URL.
ESTATE_DATABASE_URL=postgres://user:password@localhost:5432/pathway_estate_chat
ESTATE_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
ESTATE_CHAT_HOURLY_LIMIT=60

# Existing self-hosted Directus CMS. This app is one tenant and does not start Directus locally.
DIRECTUS_URL=https://cms.example.com
DIRECTUS_TOKEN=
DIRECTUS_TENANT_ID=estate-planning
DIRECTUS_CACHE_SECONDS=300

# Private local Parlant backend used by the Next.js AI SDK route.
PARLANT_BASE_URL=http://127.0.0.1:8800
# Primary lightweight AI SDK model for public-site answers before Parlant escalation.
AI_SDK_FAST_MODEL=gpt-5-nano-2025-08-07
AI_SDK_FAST_REASONING_EFFORT=minimal
PARLANT_ESCALATION_ENABLED=false
# Native Parlant NLP routing. Best latency/cost: set EMCIE_API_KEY and use auto/emcie.
# Local OpenAI fallback keeps Parlant schema calls on a tested stable nano model.
PARLANT_NATIVE_ENABLED=auto
PARLANT_NLP_SERVICE=auto
PARLANT_OPENAI_SCHEMATIC_MODEL=gpt-4.1-nano
EMCIE_API_KEY=
# Optional: use bison for compliance-sensitive, legal/tax-adjacent conversations.
EMCIE_MODEL_TIER=

# Twenty CRM lead capture.
TWENTY_BASE_URL=http://127.0.0.1:3010
TWENTY_API_TOKEN=

# Twenty outbound webhook receiver.
# Leave TWENTY_WEBHOOK_SECRET blank until the matching Twenty signature header is confirmed.
TWENTY_WEBHOOK_SECRET=
TWENTY_WEBHOOK_EVENTS_PATH=data/leads/twenty-webhook-events.jsonl
TWENTY_LEAD_SUMMARY_STATE_PATH=data/leads/twenty-lead-summary-state.json
TWENTY_LEAD_SUMMARIES_PATH=data/leads/twenty-lead-summaries.jsonl

# Optional: dispatch completed Twenty lead summaries to the local Hermes API server.
HERMES_LEAD_AUTOMATION_ENABLED=false
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_SESSION_KEY=pathway-estate-leads
HERMES_LEAD_TIMEOUT_MS=8000
HERMES_LEAD_STRATEGY_WAIT_MS=12000
HERMES_LEAD_DISPATCHES_PATH=data/leads/hermes-lead-dispatches.jsonl
HERMES_LEAD_DISPATCH_FAILURES_PATH=data/leads/hermes-lead-dispatch-failures.jsonl

# Optional: send completed lead summaries to a WhatsApp DM via Hermes' local WhatsApp bridge.
HERMES_WHATSAPP_NOTIFY_ENABLED=false
HERMES_WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
HERMES_WHATSAPP_CHAT_ID=
HERMES_WHATSAPP_TIMEOUT_MS=8000
HERMES_WHATSAPP_LEAD_DISPATCHES_PATH=data/leads/whatsapp-lead-dispatches.jsonl
HERMES_WHATSAPP_LEAD_DISPATCH_FAILURES_PATH=data/leads/whatsapp-lead-dispatch-failures.jsonl

# Cal.diy / Cal.com booking integration.
# For Cal.com Cloud use https://api.cal.com. For self-hosted Cal.diy you can use either
# CAL_WEBAPP_URL=https://cal.example.com or CAL_API_BASE_URL=https://cal.example.com/api.
CAL_API_BASE_URL=https://api.cal.com
CAL_WEBAPP_URL=
CAL_API_KEY=
# Cal API versions required by the v2 endpoints.
CAL_SLOTS_API_VERSION=2024-09-04
CAL_BOOKINGS_API_VERSION=2026-02-25
# Use the public booking URL from your Cal.diy event type, e.g. https://cal.example.com/pathway/initial-chat
CAL_BOOKING_URL=
# Identify the event type. Prefer CAL_EVENT_TYPE_ID, or use CAL_EVENT_TYPE_SLUG plus CAL_USERNAME or CAL_TEAM_SLUG.
CAL_EVENT_TYPE_ID=
CAL_EVENT_TYPE_SLUG=
CAL_USERNAME=
CAL_TEAM_SLUG=
CAL_ORGANIZATION_SLUG=
CAL_BOOKING_TIMEZONE=Europe/London
# Set this as the webhook secret in Cal.diy. Cal signs requests in x-cal-signature-256.
CAL_WEBHOOK_SECRET=
CAL_WEBHOOK_EVENTS_PATH=data/leads/cal-webhook-events.jsonl

# Local fallback lead file.
ESTATE_LEADS_PATH=data/leads/estate-handoffs.jsonl
